# Environment variables for the SOAR platform
# Copy to .env and fill in real values. Never commit .env.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Must be the service_role / secret key (server-side only). The public anon
# key is rejected because the tables are locked down to the service role.
SUPABASE_KEY=your_supabase_service_role_key
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
# Dashboard login password (required, at least 12 characters)
APP_PASSWORD=choose_a_long_random_password
# Optional — enables VirusTotal URL scanning during Scan Inbox
VIRUSTOTAL_API_KEY=your_virustotal_api_key
